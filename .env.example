# Copy to .env for local dev. These are public URLs, not secrets.

# Server-owned backend on the Lightsail box: content (GET /v1/content) +
# transcription (POST /v1/transcribe). Set to the deployed mandarin-api.
# Unset -> app falls back to the bundled corpus and disables word check.
VITE_API_BASE=https://mandarin-api.ethanadams.dev

# Legacy Cloudflare Worker: encrypted progress sync + R2 audio serving.
# Audio is still served from here; progress-sync is slated for retirement once
# accounts + server-owned progress land (Phase 3).
VITE_SYNC_URL=https://mandarin-backend.ethanadams.workers.dev
